    "lucide-react": "^0.546.0",
    "motion": "^12.42.2",
    "nodemailer": "^9.0.3",
    "pg": "^8.22.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-icons": "^5.7.0",
    "react-router-dom": "^7.18.1",
    "resend": "^6.18.0",
    "tsx": "^4.23.1",
    "vite": "^6.4.3",
    "web-push": "^3.6.7",
    "ws": "^8.21.1"
  },
